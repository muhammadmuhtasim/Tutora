rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // A user may only change their OWN document.
    // user docs are keyed by an email-encoded id (e.g. user_gmail_com) and carry an
    // `authUid` field equal to the Firebase Authentication UID, so we compare on that.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      // Account deletion is handled server-side; do not allow raw deletes from devices.
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /reports/{reportId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /chats/{sessionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
